proxmox_endpoint = "https://192.168.1.10:8006/"
proxmox_username = "root@pam"
proxmox_password = "change-me"
node_name        = "pve"

hostname     = "fakeflix"
ipv4_address = "192.168.1.50/24"
ipv4_gateway = "192.168.1.1"

rootfs_datastore = "local-lvm"
rootfs_size_gb   = 32
cores            = 4
memory_mb        = 4096

# Proxmox host dirs to bind-mount into the container: { host_path = container_path }.
# Add one line per disk if your media is spread out; then point media_dirs /
# media_mounts in ansible/group_vars/all/main.yml at the container paths.
media_mounts = {
  "/mnt/disk" = "/mnt/disk"
  # "/mnt/disk2" = "/mnt/disk2"
}

ssh_public_key_file = "~/.ssh/id_ed25519.pub"
