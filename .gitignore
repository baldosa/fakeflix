# Your settings (the symlinks pointing at them are committed)
/terraform.tfvars
/proxy.yml
/secrets.yml

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log

# Ansible
ansible/inventory/hosts.yml
ansible/collections/
ansible/host_vars/*.secret.yml
ansible/secrets/
*.retry

# Python
__pycache__/
