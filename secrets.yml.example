# Copy to secrets.yml (repo root, git-ignored) and fill in. Ansible loads it
# through the symlink in ansible/group_vars/all/.
# To keep it encrypted instead: ansible-vault encrypt secrets.yml
# and add --ask-vault-pass (or a vault password file) when running playbooks.

# DNS provider credentials for Let's Encrypt (env var names per provider:
# https://doc.traefik.io/traefik/https/acme/#providers).
proxy_acme_env:
  CF_DNS_API_TOKEN: "your-cloudflare-token"   # Zone:DNS:Edit on meme.ar

# Read-only Proxmox API token for the homepage widget. On the Proxmox host:
#   pveum user token add root@pam homepage --privsep 1
#   pveum acl modify / --tokens 'root@pam!homepage' --roles PVEAuditor
proxmox_token_id: ""        # e.g. root@pam!homepage
proxmox_token_secret: ""

# Jellyfin API key (Dashboard -> API Keys) so Sonarr/Radarr can trigger a
# library scan after every import. Used when jellyfin_url is set.
jellyfin_api_key: ""
