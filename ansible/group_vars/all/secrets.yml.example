# Copy to secrets.yml (same folder, git-ignored) and fill in.
# Ansible loads it automatically together with the other group_vars.
# To keep it encrypted instead: ansible-vault encrypt group_vars/all/secrets.yml
# and add --ask-vault-pass (or a vault password file) when running playbooks.

# DNS provider credentials for Let's Encrypt (env var names per provider:
# https://doc.traefik.io/traefik/https/acme/#providers).
proxy_acme_env:
  CF_DNS_API_TOKEN: "your-cloudflare-token"   # Zone:DNS:Edit on meme.ar
